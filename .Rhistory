mutate(treatment = factor(treatment, levels = c("標準製剤", "試験製剤1")))
pkparam_3x3 |> DT::datatable(class = "compact") |> formatStyle(columns = 1:ncol(pkparam_3x3), fontSize = "10pt")
#| code-fold: TRUE
lme_out_3x3 <- lme(log(AUC) ~ group + factor(period) + treatment, random =~ 1|subject, data = pkparam_3x3)
lme_out_3x3_d <- lme_out_3x3 |> summary() |> _$tTable
lme_out_3x3_d  |> knitr::kable()
