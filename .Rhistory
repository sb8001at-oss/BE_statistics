lm(AUC ~ treatment, data = pkparam_parallel) |> summary() |> _$df
lm(AUC ~ treatment, data = pkparam_parallel) |> summary() |> broom::tidy(conf.int = TRUE, conf.level = 0.9) |> knitr::kable()
